msgstr "{font} no está instalada en ese estilo o le faltan algunos de estos caracteres; se mantuvo la fuente propia de la línea."

msgid "Edited using the installed copy of the original font."
msgstr "Editado con la copia instalada de la fuente original."

msgid "The original font lacks some of these characters; used a Unicode font for this line."
msgstr "A la fuente original le faltan algunos de estos caracteres; se usó una fuente Unicode para esta línea."

msgid "Original font isn't available for these characters; used the closest standard font."
msgstr "La fuente original no está disponible para estos caracteres; se usó la fuente estándar más parecida."

msgid "Redaction (not applied yet)"
msgstr "Censura (aún no aplicada)"

