msgid ""
"This document wants to open:\n"
"\n"
"{address}\n"
"\n"
"Open it in your browser (or email program)?"
msgstr ""
"Este documento quiere abrir:\n"
"\n"
"{address}\n"
"\n"
"¿Desea abrirlo en su navegador (o programa de correo electrónico)?"

