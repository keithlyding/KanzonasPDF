msgstr "No hay texto ahí. Haga clic en una línea de texto para editarla."

msgid "Edit text"
msgstr "Editar texto"

msgid "This page has pending redactions; editing text would apply them. Remove them first."
msgstr "Esta página tiene censuras pendientes; editar el texto las aplicaría. Quítelas primero."

msgid "Replaced {n} (Ctrl+Z undoes it)"
msgstr "Reemplazos: {n} (Ctrl+Z lo deshace)"

msgid "{font} isn't installed in that style or lacks some of these characters; used a standard font."
msgstr "{font} no está instalada en ese estilo o le faltan algunos de estos caracteres; se usó una fuente estándar."

msgid "Text added to the page. Edit text changes it; Ctrl+Z undoes it."
msgstr "Texto agregado a la página. Editar texto lo modifica; Ctrl+Z lo deshace."

msgid "Removed the line from the scan (Ctrl+Z undoes it)."
msgstr "Se quitó la línea del escaneo (Ctrl+Z lo deshace)."

msgid "The scanned letters didn't match their recognized text, so the font couldn't be told: used Helvetica. Pick a font in Properties to change it."
msgstr "Las letras escaneadas no coincidieron con su texto reconocido, así que no se pudo determinar la fuente: se usó Helvetica. Elija una fuente en Propiedades para cambiarla."

msgid "Bold"
msgstr "Negrita"

msgid "Italic"
msgstr "Cursiva"

msgid "{wanted} isn't installed in that style or lacks some of these characters. Matched the scan: {font}, {size} pt, in the scan's color."
msgstr "{wanted} no está instalada en ese estilo o le faltan algunos de estos caracteres. Se igualó el escaneo: {font}, {size} pt, en el color del escaneo."

msgid "Matched the scan: {font}, {size} pt, in the scan's color."
msgstr "Se igualó el escaneo: {font}, {size} pt, en el color del escaneo."

msgid "Edited in {font}."
msgstr "Editado en {font}."

