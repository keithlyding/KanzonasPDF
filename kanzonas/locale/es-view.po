msgid ""
"This document wants to open:\n"
"\n"
"{path}\n"
"\n"
"Open it?"
msgstr ""
"Este documento quiere abrir:\n"
"\n"
"{path}\n"
"\n"
"¿Desea abrirlo?"

msgid "Open attached file"
msgstr "Abrir archivo adjunto"

msgid ""
"{name} could be a program, a script or a file with macros. KanzonasPDF doesn't open that kind of file from a PDF.\n"
"\n"
"Use Save as and open it yourself if you trust it."
msgstr ""
"{name} podría ser un programa, un script o un archivo con macros. KanzonasPDF no abre ese tipo de archivo desde un PDF.\n"
"\n"
"Use Guardar como y ábralo usted mismo si confía en él."

msgid ""
"Open {name}?\n"
"\n"
"Only open files from people you trust."
msgstr ""
"¿Desea abrir {name}?\n"
"\n"
"Abra solo archivos de personas en las que confíe."

msgid "Save attached file"
msgstr "Guardar archivo adjunto"

msgid "Sticky note"
msgstr "Nota adhesiva"

