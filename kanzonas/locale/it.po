msgstr "La lingua del documento ({lang}) non è un codice di lingua valido."

msgid "{n} pieces of content are neither tagged nor marked as artifacts (decoration)."
msgstr "{n} elementi di contenuto non hanno tag né sono contrassegnati come artefatti (decorazioni)."

msgid "A section holds more than one H heading."
msgstr "Una sezione contiene più di un titolo H."

