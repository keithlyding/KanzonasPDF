msgstr "Volver a mostrar la página completa en esta página o en todas"

msgid "Recognize text (&OCR)..."
msgstr "Reconocer texto (&OCR)..."

msgid "Make scanned pages searchable and selectable"
msgstr "Hacer que las páginas escaneadas se puedan buscar y seleccionar"

msgid "&Properties panel"
msgstr "Panel de propie&dades"

msgid "Show &comment boxes"
msgstr "Mostrar cuadros de &comentario"

