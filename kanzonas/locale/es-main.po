msgstr "Seleccionar: arrastre sobre el texto para seleccionarlo (Ctrl+C copia); haga clic en una anotación para moverla, cambiar su tamaño o su estilo (V)"

msgid "Hand"
msgstr "Mano"

msgid "Pan the page (H)"
msgstr "Desplazar la página (H)"

msgid "Edit text"
msgstr "Editar texto"

