msgstr "Editar el texto existente: haga clic en una línea de texto (Ctrl+E)"

msgid "Highlight"
msgstr "Resaltar"

msgid "Highlight text"
msgstr "Resaltar texto"

msgid "Underline"
msgstr "Subrayar"

msgid "Underline text"
msgstr "Subrayar texto"

msgid "Strike"
msgstr "Tachar"

msgid "Strike out text (Ctrl+Shift+X)"
msgstr "Tachar texto (Ctrl+Shift+X)"

